# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# claude code — local machine settings, not shared config.
# `.claude/*` and not `.claude/`: git never descends into an excluded
# directory, so the negations below would be dead lines under the latter.
.claude/*
# Shared on purpose — the gstack hook only enforces anything if every clone
# has it. settings.local.json stays ignored: that one is per-developer.
!.claude/settings.json
!.claude/hooks/

# tests
**/__tests__/
**/*.test.ts
**/*.test.tsx

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
drizzle/migrations/meta/

# local scratch / source catalogs (PDFs, images) — working files, not for the repo
tmp/

# supplier price-list catalogs (large PDFs/images kept locally as pricing evidence)
docs/pricelist/

# lockfile dari package manager lain — sumber konflik, dan repo ini pakai pnpm.
# pnpm-lock.yaml sengaja TIDAK diabaikan: Dockerfile menjalankan
# `pnpm install --frozen-lockfile` dan gagal tanpanya.
package-lock.json
yarn.lock
bun.lockb
bun.lock
npm-shrinkwrap.json
