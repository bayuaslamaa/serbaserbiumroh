# Database
# Self-hosted: postgresql://postgres:<password>@<dokploy-service-name>:5432/umroh_planner
# Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Set to your production domain (e.g., https://umroh.example.com)
AUTH_URL=
# Required when running behind a reverse proxy (Traefik, Nginx, etc.)
AUTH_TRUST_HOST=1

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic Claude API
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Community join WhatsApp links
# Group request link: https://chat.whatsapp.com/<invite-code>
NEXT_PUBLIC_COMMUNITY_WHATSAPP_GROUP_URL=
# Admin chat link: https://wa.me/<phone-number-with-country-code>
NEXT_PUBLIC_COMMUNITY_ADMIN_WHATSAPP_URL=

# Node
NODE_ENV=production
